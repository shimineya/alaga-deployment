// ALAGA Healthcare Monitoring System — DBML Schema
// Ready for copy-pasting directly into dbdiagram.io

Table facilities {
  facility_id int [pk, increment]
  facility_name varchar(255) [not null]
  address text
  created_at timestamp
  topology jsonb
  is_archived boolean
}

Table users {
  user_id int [pk, increment]
  username varchar(50)
  password_hash varchar(255) [not null]
  email varchar(100) [not null]
  first_name varchar(50)
  last_name varchar(50)
  role varchar(20) [not null]
  is_biometric_enabled boolean
  is_mfa_enabled boolean
  mfa_secret varchar(255)
  mfa_method varchar(20)
  created_at timestamp
  is_verified boolean
  account_status varchar(20)
  mobile_number varchar(20)
  middle_initial varchar(5)
  is_locked boolean
  failed_login_attempts integer
  force_logout_at timestamp
  facility_id integer
  last_activity_at timestamp
  profile_picture_url varchar(255)
  created_by integer
  is_archived boolean
  preferences jsonb
  deleted_at timestamp
  is_active boolean
  consent_agreed_at timestamp
  consent_version varchar(20)
  must_accept_terms boolean
}

Table user_consents {
  consent_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  consent_version varchar(20) [not null]
  forms_accepted jsonb [not null]
  ip_address varchar(45)
  user_agent text
  agreed_at timestamp
}

Table patients {
  patient_id int [pk, increment]
  name varchar(100) [not null]
  birthdate date [not null]
  patient_type varchar(50)
  device_serial_number varchar(50)
  baseline_data jsonb
  created_at timestamp
  is_archived boolean
  facility_id integer
  updated_at timestamp
  deleted_at timestamp
  svm_baseline_data jsonb
  baseline_reset_at timestamp
  is_monitoring_disabled boolean
}

Table system_modules {
  module_id varchar(100) [pk]
  display_name varchar(100) [not null]
  description text
  category varchar(50) [not null]
}

Table system_configs {
  config_key varchar(50) [pk]
  config_value jsonb [not null]
  description text
  updated_by integer
  updated_at timestamp
  is_archived boolean
}

Table device_whitelist {
  serial_number varchar(50) [pk]
  device_name varchar(50)
  firmware_version varchar(20)
  status varchar(20)
  added_by integer
  created_at timestamp
  last_heartbeat timestamp
  assigned_patient_id integer
  last_serviced_at timestamp
  device_token_hash varchar(255)
  is_archived boolean
  deleted_at timestamp
  pending_firmware_version varchar(50)
  battery_level integer
  signal_strength varchar(20)
  ip_address varchar(45)
}

Table device_snapshots {
  snapshot_id int [pk, increment]
  device_id integer
  serial_number varchar(100) [not null]
  device_name varchar(100)
  mac_address varchar(100)
  firmware_version varchar(50)
  assigned_patient_id integer
  assigned_patient_name varchar(255)
  facility_id integer
  facility_name varchar(255)
  telemetry_count integer
  alerts_count integer
  snapshot_data jsonb
  deleted_by varchar(255)
  created_at timestamp
  is_archived boolean
}

Table access_logs {
  log_id bigint [pk, increment]
  user_id integer
  target_patient_id integer
  action varchar(255)
  timestamp timestamp
  ip_address inet
  user_agent text
  resource_affected text
  severity varchar(20)
  status varchar(20)
  details jsonb
}

Table alert_notifications {
  alert_id int [pk, increment]
  event_id integer
  user_id integer
  status varchar(20)
  message text
  sent_at timestamp
  severity varchar(20)
  alert_category varchar(50)
  acknowledged_by integer
  acknowledged_at timestamp
  action_taken varchar(255)
  resolution_notes text
}

Table announcements {
  id int [pk, increment]
  title varchar(100) [not null]
  message text [not null]
  is_active boolean
  created_by integer
  created_at timestamp
  is_archived boolean
}

Table anomaly_events {
  event_id int [pk, increment]
  patient_id integer
  reading_id bigint
  anomaly_type varchar(50)
  ocsvm_score numeric(10,4)
  detected_at timestamp
}

Table archives {
  archive_id int [pk, increment]
  entity_type varchar(50) [not null]
  target_id varchar(100) [not null]
  target_name varchar(255) [not null]
  archived_by integer
  archived_at timestamp
  status varchar(20)
  facility_id integer
  details jsonb
}

Table care_logs {
  log_id int [pk, increment]
  patient_id integer [not null]
  author_id integer
  author_name varchar(100)
  content text [not null]
  created_at timestamp
  status varchar(20)
}

Table facility_invitations {
  invitation_id int [pk, increment]
  facility_id integer [not null]
  email varchar(255) [not null]
  role varchar(50) [not null]
  token varchar(64) [not null, unique]
  status varchar(20)
  created_by integer
  used_by integer
  expires_at timestamp [not null]
  created_at timestamp
  used_at timestamp
}

Table hardware_system_alerts {
  sys_alert_id int [pk, increment]
  patient_id integer
  device_mac_address varchar(50)
  alert_type varchar(100) [not null]
  severity varchar(20)
  description text
  triggered_at timestamp
  status varchar(20)
  resolved_by integer
  resolved_at timestamp
  resolution_notes text
}

Table ip_blacklist {
  id int [pk, increment]
  ip_address varchar(45) [not null]
  reason text
  banned_by integer
  banned_at timestamp
  is_archived boolean
}

Table legal_documents {
  doc_id int [pk, increment]
  doc_type varchar(50)
  title varchar(255) [not null]
  content text [not null]
  version varchar(20) [not null]
  is_active boolean
  created_by integer
  published_at timestamp
}

Table patient_access {
  access_id int [pk, increment]
  user_id integer
  patient_id integer
  relationship varchar(50)
  access_level varchar(20)
  assigned_at timestamp
  invite_status varchar(20)
  invited_by integer
  is_archived boolean
}

Table patient_baselines {
  baseline_id int [pk, increment]
  patient_id integer [not null]
  vital_name varchar(100) [not null]
  flag_count integer [not null]
  flagged_values jsonb [not null]
  mean_value numeric(6,2)
  upper_bound numeric(6,2)
  lower_bound numeric(6,2)
  updated_at timestamp [not null]
}

Table profiles_caregivers {
  profile_id int [pk, increment]
  user_id integer
  caregiver_type varchar(50)
  certifications text[]
  years_experience integer
  agency_name varchar(150)
  emergency_contact varchar(50)
  updated_at timestamp
  work_shift varchar(50)
  notification_preferences text[]
}

Table profiles_medical_staff {
  profile_id int [pk, increment]
  user_id integer
  license_number varchar(50) [not null]
  specialization varchar(100)
  hospital_affiliation varchar(150)
  years_of_practice integer
  schedule_availability jsonb
  updated_at timestamp
  practice_type varchar(50)
  is_solo_practitioner boolean
}

Table reports {
  report_id int [pk, increment]
  user_id integer
  patient_id integer
  report_type varchar(50)
  file_url varchar(255)
  generated_at timestamp
}

Table role_permissions {
  id int [pk, increment]
  role varchar(50) [not null]
  module_id varchar(100) [not null]
  is_enabled boolean [not null]
  updated_by integer
  updated_at timestamp
}

Table schedules {
  schedule_id int [pk, increment]
  patient_name varchar(255) [not null]
  event_type varchar(100) [not null]
  custom_event_name text
  is_recurring boolean
  recurrence_interval varchar(50)
  scheduled_at timestamp [not null]
  status varchar(50)
  created_at timestamp
  is_archived boolean
}

Table sensor_readings {
  reading_id bigint [pk, increment]
  patient_id integer
  heart_rate integer
  spo2 integer
  temperature numeric(5,2)
  moisture_value integer
  recorded_at timestamp
}

Table session_revocations {
  user_id integer [pk]
  revoked_before timestamp [not null]
  revoked_by integer
  reason text
}

Table system_reports {
  report_id int [pk, increment]
  title varchar(255) [not null]
  category varchar(100) [not null]
  report_type varchar(100) [not null]
  severity varchar(50)
  summary text
  details jsonb
  generated_by varchar(100)
  is_archived boolean
  created_at timestamp
  updated_at timestamp
}

Table user_documents {
  document_id int [pk, increment]
  user_id integer
  document_type varchar(50) [not null]
  file_url varchar(255) [not null]
  upload_date timestamp
  verification_status varchar(20)
  reviewed_by integer
  rejection_reason text
}

Table user_email_otps {
  otp_id int [pk, increment]
  user_id integer [not null]
  email varchar(255) [not null]
  otp_code varchar(6)
  expires_at timestamp [not null]
  is_verified boolean
  created_at timestamp
  purpose varchar(50)
  consumed_at timestamp
  otp_hash varchar(255)
  last_sent_at timestamp
  attempts_count integer
}

Table user_firmware_downloads {
  download_id int [pk, increment]
  user_id integer
  firmware_version varchar(50)
  device_type varchar(50)
  download_url text
  downloaded_at timestamp
  status varchar(50)
}

Table user_permission_overrides {
  id int [pk, increment]
  user_id integer [not null]
  module_id varchar(100) [not null]
  is_granted boolean [not null]
  override_reason text
  overridden_by integer
  overridden_at timestamp
}

// Relationships
Ref: access_logs.target_patient_id > patients.patient_id
Ref: access_logs.user_id > users.user_id
Ref: alert_notifications.acknowledged_by > users.user_id
Ref: alert_notifications.event_id > anomaly_events.event_id
Ref: alert_notifications.user_id > users.user_id
Ref: announcements.created_by > users.user_id
Ref: anomaly_events.patient_id > patients.patient_id
Ref: anomaly_events.reading_id > sensor_readings.reading_id
Ref: archives.archived_by > users.user_id
Ref: archives.facility_id > facilities.facility_id
Ref: care_logs.author_id > users.user_id
Ref: care_logs.patient_id > patients.patient_id
Ref: facility_invitations.facility_id > facilities.facility_id
Ref: facility_invitations.created_by > users.user_id
Ref: facility_invitations.used_by > users.user_id
Ref: device_whitelist.added_by > users.user_id
Ref: device_whitelist.assigned_patient_id > patients.patient_id
Ref: hardware_system_alerts.patient_id > patients.patient_id
Ref: hardware_system_alerts.resolved_by > users.user_id
Ref: ip_blacklist.banned_by > users.user_id
Ref: legal_documents.created_by > users.user_id
Ref: patient_access.patient_id > patients.patient_id
Ref: patient_access.user_id > users.user_id
Ref: patient_baselines.patient_id > patients.patient_id
Ref: patients.facility_id > facilities.facility_id
Ref: profiles_caregivers.user_id > users.user_id
Ref: profiles_medical_staff.user_id > users.user_id
Ref: reports.patient_id > patients.patient_id
Ref: reports.user_id > users.user_id
Ref: role_permissions.module_id > system_modules.module_id
Ref: role_permissions.updated_by > users.user_id
Ref: sensor_readings.patient_id > patients.patient_id
Ref: session_revocations.revoked_by > users.user_id
Ref: session_revocations.user_id > users.user_id
Ref: system_configs.updated_by > users.user_id
Ref: user_documents.reviewed_by > users.user_id
Ref: user_documents.user_id > users.user_id
Ref: user_email_otps.user_id > users.user_id
Ref: user_firmware_downloads.user_id > users.user_id
Ref: user_permission_overrides.overridden_by > users.user_id
Ref: user_permission_overrides.user_id > users.user_id
Ref: users.created_by > users.user_id
Ref: users.facility_id > facilities.facility_id